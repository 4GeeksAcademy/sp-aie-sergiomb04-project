    {
      "event_type": "inbound_order_created",
      "classification": "obligatorio",
      "category": "inventario",
      "description": "Recepcion de mercancia registrada en almacen",
      "businessHypothesis": "Necesitamos saber cuanto volumen entra, por cliente y por almacen.",
      "decisionEnabled": "Planificar capacidad de almacen y personal segun volumen entrante.",
      "delivery": {
        "mode": "stream",
        "justification": "Evento critico de operacion de almacen",
        "frequencyControl": "none"
      },
      "allowlist": [
        "warehouse",
        "client_id",
        "product_id",
        "product_category",
        "quantity",
        "order_id",
        "reference",
        "user_uuid"
      ],
      "properties": [
        {
          "name": "warehouse",
          "type": "string",
          "required": true,
          "enum": ["los_angeles", "zaragoza"],
          "description": "Almacen operativo",
          "sensitivity": "internal",
          "containsPII": false,
          "sanitization": "normalizar valor canonico"
        },
        {
          "name": "client_id",
          "type": "string",
          "required": true,
          "description": "Identificador de cliente B2B",
          "sensitivity": "internal",
          "containsPII": false,
          "sanitization": "trim y validacion de formato"
        },
        {
          "name": "product_id",
          "type": "string",
          "required": true,
          "description": "Identificador SKU",
          "sensitivity": "internal",
          "containsPII": false,
          "sanitization": "normalizar y validar existencia"
        },
        {
          "name": "product_category",
          "type": "string",
          "required": true,
          "enum": ["fashion", "electronics", "cosmetics"],
          "description": "Categoria del SKU",
          "sensitivity": "internal",
          "containsPII": false,
          "sanitization": "normalizar a taxonomia"
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": true,
          "description": "Unidades entrantes",
          "sensitivity": "internal",
          "containsPII": false,
          "sanitization": "entero positivo"
        },
        {
          "name": "order_id",
          "type": "string",
          "required": true,
          "description": "Identificador tecnico de orden inbound",
          "sensitivity": "internal",
          "containsPII": false,
          "sanitization": "uuid o id numerico como string"
        },
        {
          "name": "reference",
          "type": "string",
          "required": true,
          "description": "Referencia operativa de entrada",
          "sensitivity": "internal",
          "containsPII": false,
          "sanitization": "limitar longitud y remover texto sensible"
        },
        {
          "name": "user_uuid",
          "type": "string",
          "required": true,
          "description": "Usuario que registra la entrada",
          "sensitivity": "restricted",
          "containsPII": true,
          "sanitization": "pseudonimo interno; no email"
        }
      ]
    },
