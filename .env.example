# Puertos publicados en host
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001
SERVICES_PORT=8000
MCP_PORT=8001

# URLs internas entre contenedores (usar nombre de servicio Docker)
TRACKFLOW_API_BASE_URL=http://services:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://services:8000

# Configuracion backend en desarrollo
SECRET_KEY=change-me-in-local-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRACKFLOW_DB_PATH=/workspace/services/api/trackflow_api/data/db.json
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:3001/reset-password
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DATABASE_URL=sqlite:///trackflow_api/data/inventory.db
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant) & LLM
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=trackflow_knowledge
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
